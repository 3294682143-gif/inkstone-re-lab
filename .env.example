# 仅字段名与占位符；真实值放本地受控文件，不入库、不入日志。
#
# 重要：本程序「不会」自动加载 .env 文件。请在 shell 中显式导出（export ...），
# 或用命令行参数传入。创建 .env 文件本身不会生效。
#
# 全部变量均为可选；不设置时使用括号内默认值。

# 接口基址（默认 https://discovery.intern-ai.org.cn）
INKSTONE_BASE_URL=https://discovery.intern-ai.org.cn

# 登录态文件路径（默认 01-evidence/private/inkstone-auth.json）
# 未配置代理时允许直连；不要提交真实文件。
INKSTONE_STORAGE_STATE=01-evidence/private/inkstone-auth.json

# 代理：仅在明确设置时才启用；不设置则直连。（也兼容标准 HTTPS_PROXY / HTTP_PROXY）
# 例：export INKSTONE_PROXY=http://127.0.0.1:9999
# INKSTONE_PROXY=

# 请求/读取超时毫秒（默认 60000；0 表示不超时）
# INKSTONE_TIMEOUT_MS=60000
